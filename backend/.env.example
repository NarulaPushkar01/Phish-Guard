# ===========================================
# PhishGuard - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/phishguard

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# API Keys (optional - app works in demo mode without them)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=

# File Upload
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
